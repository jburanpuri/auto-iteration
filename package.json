{
  "name": "auto-iteration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "demo": "node --import=tsx src/demo.ts",
    "feedback:api": "node --import=tsx src/feedback-server.ts",
    "feedback:send": "node --import=tsx src/feedback-send.ts",
    "cli": "node --import=tsx src/cli.ts",
    "slack": "node --import=tsx src/slack.ts",
    "worker": "node --import=tsx src/worker.ts",
    "check": "tsc --noEmit",
    "test": "node --import=tsx --test test/*.test.ts",
    "demo:live": "node --import=tsx src/demo-live.ts",
    "demo:cli": "node --import=tsx src/demo-cli.ts",
    "demo:worker": "node --import=tsx src/demo-worker.ts",
    "discord": "node --import=tsx src/discord.ts",
    "codex:login": "node node_modules/@openai/codex/bin/codex.js login",
    "codex:status": "node node_modules/@openai/codex/bin/codex.js login status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.154.0",
    "@slack/bolt": "5.1.0",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "inngest": "4.20.0",
    "playwright": "1.63.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "agent-browser": "0.27.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
