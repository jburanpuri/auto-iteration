# No credentials needed for npm run demo or npm run cli -- init.
EXECUTOR=demo
DATA_DIR=.local
ORGANIZATION_ID=demo-company
# Optional local fake-product feedback API (npm run feedback:api).
# FEEDBACK_PORT=4318

# Auto Iteration live product + Discord demo: npm run demo:live.
# This command uses Codex by default, independently of EXECUTOR above.
DEMO_EXECUTOR=codex
# DEMO_DATA_DIR=.local/northstar-company-demo
# DEMO_OPERATOR_PORT=4319

# Create a Discord application named Auto Iteration. Enable Message Content Intent.
# The engineering channel is also the fallback for unconfigured teams.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_CHANNEL_ID=
# DISCORD_UI_UX_CHANNEL_ID=
# DISCORD_PERFORMANCE_CHANNEL_ID=
# Comma-separated Discord USER IDs allowed to approve in configured channels.
# DISCORD_APPROVER_IDS=

# Optional separate conversational model. Choose a model supporting structured outputs.
# When unset, conversation uses Codex. Codex always owns investigation and implementation.
# CONVERSATION_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=provider/model-id

# Live Codex mode requires a separate, trusted, already-cloned Git repository.
# EXECUTOR=codex
# TARGET_REPO_PATH=/absolute/path/to/customer-demo-repo
# TARGET_BASE_REF=main
# TEST_COMMAND_JSON=["npm","test"]
# OPENAI_API_KEY=
# CODEX_MODEL=

# Slack Socket Mode; these are credentials for YOUR product's Slack app.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_TEAM_ID=T...
# SLACK_CHANNEL_ID=C...
# SLACK_APPROVER_IDS=U123,U456

# Optional external research. Queries must be supplied explicitly and contain
# public technical terms only; customer feedback is never searched automatically.
# BRAVE_SEARCH_API_KEY=

# Optional Inngest worker. The local CLI otherwise runs jobs directly.
# INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# WORKER_PORT=3000
# JOB_RUNNER=inngest

# Hosted demo bridge: Vercel inbox + this persistent local Codex/Discord worker.
# npm run demo:hosted (requires hosted/.env.local from vercel env pull)
# CODEX_MODEL=gpt-6-astra
# CODEX_REASONING_EFFORT=low
# PUBLIC_DEMO_URL=https://northstar-auto-iteration.vercel.app
# AUTO_PUBLISH=1

# Set a random DEMO_ACCESS_CODE in Vercel's encrypted production environment.
# Required for feedback submission, workflow start, and demo reset.
# Never put the actual code in this template or client-side JavaScript.
# DEMO_ACCESS_CODE=
